# =============================================================
# SISTEMA DE SALAS PUCRS — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais
# NUNCA commite o arquivo .env
# =============================================================

# --- FRONTEND (prefixo VITE_ obrigatório para exposição ao browser) ---

# URL do projeto Supabase (visível no dashboard: Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Chave anon/public do Supabase (safe para expor no frontend)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL base da API — use http://localhost:3000 para dev local com vercel dev
VITE_API_URL=http://localhost:3000

# --- BACKEND (serverless Vercel — nunca exposto ao browser) ---

# URL do projeto Supabase (igual ao VITE_SUPABASE_URL)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Chave service_role do Supabase — SEGREDO, nunca expor ao frontend
# Visível em: Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL da API Python para extração de PDF (hospedada no Render.com)
# Opcional — necessário apenas para o módulo de upload de grade
PYTHON_API_URL=https://seu-servico-de-extracao.onrender.com

# --- MIGRATIONS (`npm run migrate` — nunca exposto ao browser) ---

# Connection string do Postgres para aplicar as migrations via psql.
# NÃO é a service_role key (aquela é da API REST). Pegue em:
#   Supabase → Settings → Database → Connection string → "Session pooler"
# Use a porta 5432 (session pooler / conexão direta), NÃO a 6543 (transaction).
# SEGREDO — contém a senha do banco.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Allowlist de domínios para convite de membros (opcional).
# Vazio/ausente = sem restrição. Ex.: "pucrs.br,edu.pucrs.br"
INVITE_EMAIL_DOMINIOS=

# URL pública do sistema — para onde o link do e-mail de convite leva.
# Sem isso o Supabase usa a "Site URL" do dashboard (default http://localhost:3000,
# que gera link quebrado). Na Vercel, o fallback é o domínio de produção do projeto.
# Este mesmo endereço precisa estar em Supabase → Authentication → URL Configuration.
APP_URL=https://sistema-salas-pucrs.vercel.app
